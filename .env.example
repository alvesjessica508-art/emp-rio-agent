# Qualquer provedor com API compatível com OpenAI Chat Completions + function calling.
# Copie este arquivo para .env e preencha LLM_API_KEY.

# --- Opção 1 (padrão): Google Gemini via endpoint de compatibilidade OpenAI ---
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# --- Opção 2: OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1/
# LLM_MODEL=gpt-4o-mini

# --- Opção 3: Groq ---
# LLM_BASE_URL=https://api.groq.com/openai/v1/
# LLM_MODEL=llama-3.3-70b-versatile

# --- Opção 4: modelo local com Ollama (sem chave; use qualquer valor em LLM_API_KEY) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1/
# LLM_MODEL=qwen2.5:7b-instruct

# Ajustes opcionais
# LLM_TEMPERATURE=0.2
# MAX_TOOL_STEPS=6
# HISTORY_WINDOW=20
# AGENT_NOW=2026-03-25T10:30   # fixa o "agora" (demos reproduzíveis)
